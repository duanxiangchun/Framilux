# 跨平台仓库：仓库内统一 LF，避免 Windows/Android 之间的换行抖动
* text=auto eol=lf

# 文本类显式声明
*.kt   text
*.kts  text
*.ts   text
*.md   text
*.json text

# 二进制（不要做任何换行/差异转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.tflite binary
*.onnx binary
*.bin  binary
*.pt   binary
*.lock binary

# pnpm 锁文件按文本走 diff
pnpm-lock.yaml text eol=lf
